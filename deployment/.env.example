# =================================================================================================
# .env.example - Environment Configuration Template
# =================================================================================================
# Copy this file to .env and fill in your actual values before running docker-compose or agents.
# Never commit .env with real secrets to version control.
#
# This template includes all environment variables used across:
# - Core framework (harness, envelope, deep_agents)
# - Three-tier architecture (tier_1, tier_2, tier_3)
# - Services layer (persistence, redis, vector_db, external_apis)
# - Infrastructure (Redis, PostgreSQL/Supabase)
# =================================================================================================

# -------------------------------------------------------------------------------------------------
# INFRASTRUCTURE: Redis Configuration
# -------------------------------------------------------------------------------------------------
# Docker containers (compose default): redis://redis:6379/0
# Local scripts (outside Docker):      redis://localhost:6379/0
# Production: redis://[password@]host:port[/db] (use TLS in production)
REDIS_URL=redis://:<REDIS_PASSWORD>@your-redis-host:6379/0
REDIS_URL_DOCKER=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=<REDIS_PASSWORD>
REDIS_NAMESPACE=agentic
REDIS_DEBUG=0

# -------------------------------------------------------------------------------------------------
# INFRASTRUCTURE: PostgreSQL / Supabase Configuration
# -------------------------------------------------------------------------------------------------
# For local PostgreSQL (via docker compose):
#   postgres://agentic:agentic_dev@postgres:5432/agentic
# For Supabase:
#   postgres://postgres.[project_id]:[password]@db.[project_id].supabase.co:5432/postgres
DATABASE_URL=
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=<REDACTED>

# -------------------------------------------------------------------------------------------------
# INFRASTRUCTURE: Redis Streams Configuration
# -------------------------------------------------------------------------------------------------
# Stream naming pattern: [namespace]:agents:[agent_type]:tasks/results
REDIS_NAMESPACE=agentic
STREAM_MAXLEN=1000
PERSIST_KIND=supabase  # Options: supabase, postgresql, snowflake, bigquery

# -------------------------------------------------------------------------------------------------
# API KEYS & EXTERNAL SERVICES
# -------------------------------------------------------------------------------------------------
# OpenAI API (required for LLM operations and embeddings)
OPENAI_API_KEY=sk-...

# Vector Database Backends
VECTOR_DB_BACKEND=pinecone  # Options: pinecone, weaviate, in-memory
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
WEAVIATE_URL=http://weaviate:8080

# External APIs
CRUNCHBASE_API_KEY=
LINKEDIN_API_KEY=
CRUNCHBASE_BASE_URL=https://api.crunchbase.com
LINKEDIN_BASE_URL=https://api.linkedin.com

# Gmail SMTP (used by Channel Sequencer for outbound email)
GMAIL_SENDER_EMAIL=
GMAIL_APP_PASSWORD=

# -------------------------------------------------------------------------------------------------
# TIER 1: Manager Configuration
# -------------------------------------------------------------------------------------------------
# Strategic decision-making tier
MANAGER_TOPIC=manager:tasks
MANAGER_RESULT_TOPIC=manager:results
MANAGER_HEARTBEAT_INTERVAL=60  # seconds

# -------------------------------------------------------------------------------------------------
# TIER 2: Orchestrators Configuration
# -------------------------------------------------------------------------------------------------
# Leads Orchestrator
LEADS_ORCHESTRATOR_TOPIC=leads:orchestrator:tasks
LEADS_ORCHESTRATOR_RESULT_TOPIC=leads:orchestrator:results

# Outreach Orchestrator
OUTREACH_ORCHESTRATOR_TOPIC=outreach:orchestrator:tasks
OUTREACH_ORCHESTRATOR_RESULT_TOPIC=outreach:orchestrator:results

# -------------------------------------------------------------------------------------------------
# TIER 3: Agents Configuration
# -------------------------------------------------------------------------------------------------
# RAG Agent (Research & Analysis)
RAG_AGENT_TOPIC=rag:tasks
RAG_AGENT_RESULT_TOPIC=rag:results
EMBEDDING_MODEL=text-embedding-3-small  # Options: text-embedding-3-small, text-embedding-3-large

# Persistence Agent (Database Operations)
PERSISTENCE_AGENT_TOPIC=persistence:tasks
PERSISTENCE_AGENT_RESULT_TOPIC=persistence:results

# Copywriter Agent (Content Generation)
COPYWRITER_AGENT_TOPIC=copywriter:tasks
COPYWRITER_AGENT_RESULT_TOPIC=copywriter:results

# -------------------------------------------------------------------------------------------------
# SERVICES: Persistence Service
# -------------------------------------------------------------------------------------------------
# Database adapter selection and configuration
PERSIST_KIND=supabase
MAX_POOL_SIZE=20
MIN_POOL_SIZE=5
CONNECTION_TIMEOUT=30
QUERY_TIMEOUT=60

# -------------------------------------------------------------------------------------------------
# SERVICES: Vector DB Service
# -------------------------------------------------------------------------------------------------
# Embedding and vector search configuration
EMBEDDING_CACHE_SIZE=10000  # in-memory cache for embeddings
SIMILARITY_THRESHOLD=0.75
BATCH_SIZE=128

# -------------------------------------------------------------------------------------------------
# SERVICES: External APIs Service
# -------------------------------------------------------------------------------------------------
# API client configuration
API_REQUEST_TIMEOUT=30
API_RETRY_COUNT=3
API_RATE_LIMIT_RPM=60  # requests per minute
API_BACKOFF_FACTOR=2

# -------------------------------------------------------------------------------------------------
# OPERATIONS & MONITORING
# -------------------------------------------------------------------------------------------------
# Heartbeat and operational monitoring
OPS_HB_ENABLED=1
OPS_HB_INTERVAL=60
WORKER_ONCE=0  # Set to 1 for one-shot execution (testing)
REDIS_DEBUG=0  # Set to 1 for verbose Redis logging

# -------------------------------------------------------------------------------------------------
# MULTI-TENANCY
# -------------------------------------------------------------------------------------------------
# Tenant identification for stream segregation and data isolation
TENANT_ID=agentic-dev

# -------------------------------------------------------------------------------------------------
# TRACING & OBSERVABILITY (OpenTelemetry)
# -------------------------------------------------------------------------------------------------
# Distributed tracing setup for end-to-end visibility
OTEL_ENABLED=0
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=agentic-system
OTEL_SAMPLER=parentbased_traceidratio
OTEL_SAMPLER_ARG=0.1

# -------------------------------------------------------------------------------------------------
# LOGGING
# -------------------------------------------------------------------------------------------------
# Application logging configuration
LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json  # Options: json, text
LOG_FILE=/var/log/agentic/app.log
LOG_MAX_SIZE=104857600  # 100MB
LOG_BACKUP_COUNT=10

# -------------------------------------------------------------------------------------------------
# FEATURE FLAGS
# -------------------------------------------------------------------------------------------------
# Feature toggles for gradual rollouts and A/B testing
FEATURE_VECTOR_SEARCH_ENABLED=1
FEATURE_EXTERNAL_API_ENRICHMENT_ENABLED=1
FEATURE_DEEP_AGENTS_ENABLED=0  # Optional Deep Agents integration
FEATURE_WORKFLOW_STATE_PERSISTENCE_ENABLED=1

# -------------------------------------------------------------------------------------------------
# DOCKER COMPOSE SPECIFIC
# -------------------------------------------------------------------------------------------------
# Settings specific to docker-compose deployments
COMPOSE_PROJECT_NAME=agentic
COMPOSE_PROFILES=local

