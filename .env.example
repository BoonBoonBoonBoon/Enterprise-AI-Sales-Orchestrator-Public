# Copy to .env and fill in your secrets (do NOT commit the real values)

# Supabase: prefer anon or role-scoped keys with minimal privileges
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=<REDACTED>

# OpenAI: project or key scoped appropriately
OPENAI_API_KEY=sk-...

# Redis: prefer REDIS_URL; for TLS use rediss:// and the TLS port
# examples:
# REDIS_URL=redis://user:password@host:port/0
# REDIS_URL=rediss://user:password@host:tls_port/0
REDIS_URL=redis://:<REDIS_PASSWORD>@your-redis-host:6379/0
REDIS_NAMESPACE=agentic-dev

# Persistence backend kind: supabase | memory
PERSIST_KIND=supabase
